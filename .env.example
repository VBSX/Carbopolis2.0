# Flask
SECRET_KEY=altere-esta-chave-em-producao
FLASK_DEBUG=1

# Banco local (desenvolvimento)
DATABASE_URL=sqlite:///carbopolis.db

# Google Gemini (configure em Google AI Studio; nunca compartilhe a chave)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (alternativa usada quando o Gemini falha; console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

